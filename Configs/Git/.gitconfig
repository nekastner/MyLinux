[user]
	email = elias@kastner-home.com
	name = Noah Elias Kastner
[pull]
	ff = only
[init]
	defaultBranch = main
[core]
	editor = nvim
[alias]
	clean-ignore = !git rm -r --cached . && git add .
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
