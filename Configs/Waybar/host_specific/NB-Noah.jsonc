[
	{
		"output": "eDP-1",

		"include": [
			"~/.config/waybar/modules/all.jsonc",
			"~/.config/waybar/host_specific/NB-Noah/all.jsonc"
		],

		"layer": "top",
		"position": "top",

		"height": 32,
		"spacing": 5,

		"modules-left": [
			"hyprland/workspaces",
			"hyprland/submap"
		],
		"modules-center": [
			"clock"
		],
		"modules-right": [
			"mpris",
			"wireplumber#sinks",
			"wireplumber#sources",
			"network",
			"bluetooth",
			"temperature#cpu",
			"battery",
			"tray"
		]
	},
	{
		"output": [
			"!eDP-1",
			"*"
		],

		"include": [
			"~/.config/waybar/modules/all.jsonc",
			"~/.config/waybar/host_specific/NB-Noah/all.jsonc"
		],

		"layer": "top",
		"position": "top",

		"height": 32,
		"spacing": 5,

		"modules-left": [
			"hyprland/workspaces",
			"hyprland/submap"
		],
		"modules-center": [
			"clock"
		],
		"modules-right": [
			"wireplumber#sinks",
			"wireplumber#sources"
		]
	}
]
