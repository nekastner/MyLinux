[
	{
		"output": "HDMI-A-1",

		"include": [
			"~/.config/waybar/modules/all.jsonc",
			"~/.config/waybar/host_specific/PC-Elias/all.jsonc"
		],

		"layer": "top",
		"position": "top",

		"height": 32,
		"spacing": 5,

		"modules-left": [
			"hyprland/workspaces",
			//"hyprland/mode",
			//"keyboard-state",
			"tray"
		],
		"modules-center": [
			"clock"
		],
		"modules-right": [
			"mpris",
			"wireplumber",
			"network",
			"bluetooth",
			//"cpu",
			"temperature#cpu",
			"temperature#gpu"
		]
	},

	{
		"output": "HDMI-A-2",

		"include": [
			"~/.config/waybar/modules/all.jsonc",
			"~/.config/waybar/host_specific/PC-Elias/all.jsonc"
		],

		"layer": "top",
		"position": "top",

		"height": 32,
		"spacing": 5,

		"modules-left": [
			"hyprland/workspaces",
			//"hyprland/mode",
			//"keyboard-state",
			"tray"
		],
		"modules-center": [
			"clock"
		],
		"modules-right": [
			"wireplumber",
			//"cpu",
			"temperature#cpu",
			"temperature#gpu"
		]
	}
]
