[
	{
		"output": "HDMI-A-1",

		"include": "~/.config/waybar/modules/all.jsonc",

		"layer": "top",
		"position": "top",

		"height": 32,
		"spacing": 5,

		"modules-left": [
			"hyprland/workspaces",
			"hyprland/mode"
		],
		"modules-center": [
			"clock"
		],
		"modules-right": [
			"keyboard-state",
			"mpris",
			"wireplumber",
			"network",
			"bluetooth",
			"temperature#cpu",
			"temperature#gpu",
			"tray"
		]
	},

