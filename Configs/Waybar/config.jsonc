{
	"layer": "bottom",
	"position": "top",

	"height": 24,
	"spacing": 5,

	"modules-left": ["hyprland/workspaces","hyprland/mode"],
	"modules-center": ["tray"],
	"modules-right": ["wireplumber","backlight","battery","clock"],

	"hyprland/workspaces": {
		"format": "{icon}",
		"on-click": "activate"
	},

	"wireplumber": { 
		"format": "{volume}%"
	},

	"backlight": {
		"format": "{percent}%"
	},

	"battery": {
		"bat": "BAT0",
		"states": {
			"good": 80,
			"warning": 50,
			"critical": 30
		},
		"format": "{capacity}%",
		"format-charging": "{capacity}% (charging)",
		"format-plugged": "{capacity}% (plugged)"
	},

	"clock": {
		"format": "{:%Y.%m.%d %H:%M}"
	},

	"tray": {
		"icon-size": 20,
		"spacing": 10
	}
}
