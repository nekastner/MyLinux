{
  "permissions": {
    "deny": [
      "Read(//etc/**)",
      "Read(//root/**)",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(**/.env)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true
  },
  "theme": "dark",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  }
}
