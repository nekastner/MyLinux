{
	"sandbox": {
		"enabled": true,
		"failIfUnavailable": true,
		"allowUnsandboxedCommands": false,
		"filesystem": {
			"denyRead": ["/etc", "/root", "/home", "/proc", "/sys", "~/"],
			"allowRead": ["."],
			"allowWrite": ["."]
		},
		"network": {
			"allowedDomains": ["github.com", "*.npmjs.org", "*.pypi.org"]
		},
		"credentials": {
			"files": [
				{ "path": "~/.ssh", "mode": "deny" },
				{ "path": "~/.aws", "mode": "deny" }
			],
			"envVars": [
				{ "name": "GITHUB_TOKEN", "mode": "deny" }
			]
		}
	}
}
